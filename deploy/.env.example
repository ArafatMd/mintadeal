# Copy to deploy/.env on the server and chmod 600. Never commit the real file.
# Generate each secret with: openssl rand -base64 48

# Your domain; the apps live on api., app., shop., admin. and rider. subdomains.
DOMAIN=mintadeal.in

DB_PASSWORD=
JWT_SECRET=
OTP_PEPPER=
# Encrypts Razorpay/2Factor/WhatsApp secrets in the database. Save it in a password manager and NEVER change it.
SETTINGS_ENCRYPTION_KEY=

# Comma-separated 10-digit phone numbers that become admins on sign-in.
ADMIN_PHONES=

# Only for the very first sign-in, before 2Factor is set up: a random 6-digit code
# (e.g. `shuf -i 100000-999999 -n 1`). It stops working once 2Factor is switched on; delete it then.
FIRST_SIGNIN_CODE=

# SkillPeck's Docker network (the one its Caddy container is on).
EDGE_NETWORK=deploy_default

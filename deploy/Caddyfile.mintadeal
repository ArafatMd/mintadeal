# Append these blocks to SkillPeck's ~/skillpeck/deploy/Caddyfile,
# then: docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --force-recreate caddy

api.mintadeal.com {
	request_body max_size 8MB
	reverse_proxy mintadeal-api:8080
}

app.mintadeal.com {
	reverse_proxy mintadeal-web:8081
}

shop.mintadeal.com {
	reverse_proxy mintadeal-web:8082
}

admin.mintadeal.com {
	reverse_proxy mintadeal-web:8083
}

rider.mintadeal.com {
	reverse_proxy mintadeal-web:8084
}
